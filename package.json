{
  "private": true,
  "name": "desknotch",
  "productName": "CatNotch",
  "description": "CatNotch is an app for Windows and macOS that gives you a notch, just like the Apple devices",
  "version": "1.0.6",
  "author": "Devezio.tech",
  "copyright": "Copyright © 2026 Yash Srivastava and Chary",
  "appId": "com.devezio.desknotch",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "dev": "npm run clean:port && node scripts/patch-nextron.cjs && nextron --startup-delay 20000",
    "dev:norestart": "node scripts/patch-nextron.cjs && cross-env NEXTRON_NO_RESTART=1 nextron --startup-delay 20000",
    "build": "nextron build",
    "build:helper": "sh scripts/build-helper.sh",
    "clean:port": "npx --yes kill-port 8888",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  },
  "dependencies": {
    "bot-avatars": "^0.1.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.0",
    "electron-updater": "^6.8.9",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.0",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "next": "^16.3.0",
    "nextron": "^10.3.0",
    "node-api-headers": "^1.9.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
